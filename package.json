{
  "name": "openclaw-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only live runtime observer for one OpenClaw Gateway",
  "bin": {
    "openclaw-collector": "dist/server/main.js"
  },
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/main.ts start --config collector.config.json",
    "dev:web": "vite --host 127.0.0.1",
    "mock:gateway": "tsx scripts/mock-gateway.ts",
    "demo": "OPENCLAW_GATEWAY_TOKEN=collector-dev-token tsx src/main.ts start --config scripts/mock.config.json",
    "capture:ui": "tsx scripts/capture-ui.ts",
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "start": "node dist/server/main.js start --config collector.config.json",
    "check": "tsx src/main.ts check --config collector.config.json",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.6.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
